# =============================================================
# Secret Desire — Variáveis de ambiente
# Copie para .env e preencha com seus valores reais
# =============================================================

# --- Supabase ---
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta

# --- URL base da aplicação ---
APP_URL=http://localhost:3000

# --- MercadoPago (Pix e Boleto) ---
# Obtenha em: https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxx
MERCADOPAGO_WEBHOOK_SECRET=sua_signature_secreta

# --- Stripe (Cartão de Crédito) ---
# Obtenha em: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- PagSeguro (alternativa) ---
# Obtenha em: https://developer.pagbank.com.br
PAGSEGURO_TOKEN=seu_token_pagseguro

# --- Configuração de gateways por método de pagamento ---
# Valores: mercadopago | stripe | pagseguro
PIX_GATEWAY=mercadopago
BOLETO_GATEWAY=mercadopago
CARD_GATEWAY=stripe
